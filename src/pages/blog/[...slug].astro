---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Tag from '../../components/Tag.astro';
import { formatDate, isoDate } from '../../utils/format';
import { siteBase, personSchema, blogPostingSchema, breadcrumbSchema } from '../../utils/seo';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const baseUrl = siteBase(Astro.site);
const schema = [
  personSchema(baseUrl),
  blogPostingSchema(baseUrl, { ...d, slug: post.id }),
  breadcrumbSchema(baseUrl, [
    { name: 'Blog', path: '/blog' },
    { name: d.title, path: `/blog/${post.id}` },
  ]),
];
---

<Base
  title={d.title}
  description={d.excerpt}
  type="article"
  publishedTime={d.date}
  tags={d.tags}
  imageAlt={`${d.title} — mcinnis.dev`}
  schema={schema}
>
  <div class="post-head container container--prose">
    <Button variant="ghost" size="sm" icon="arrow-left" iconPosition="left" href="/blog" class="post-head__back">
      All posts
    </Button>

    <div class="post-head__meta">
      <time datetime={isoDate(d.date)}>{formatDate(d.date)}</time>
      {d.project && <span class="post-head__project">{d.project}</span>}
    </div>

    <h1 class="post-head__title">{d.title}</h1>
  </div>

  <div class="post-body container container--prose">
    <article class="prose">
      <p class="post-body__standfirst">{d.excerpt}</p>
      <Content />
    </article>

    {d.tags.length > 0 && (
      <div class="post-body__tags">
        {d.tags.map((t) => <Tag>{t}</Tag>)}
      </div>
    )}
  </div>
</Base>

<style>
  .post-head {
    padding-block: var(--space-7) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .post-head__back { align-self: flex-start; margin-left: calc(var(--space-4) * -1); }
  .post-head__meta {
    display: flex; align-items: center; gap: var(--space-3);
    font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-meta);
  }
  .post-head__project { color: var(--text-accent); }
  .post-head__title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    letter-spacing: -.04em;
    line-height: var(--leading-snug);
    color: var(--text-display);
  }

  .post-body {
    padding-bottom: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .post-body__standfirst { font-size: var(--text-xl); color: var(--text-display); }
  .post-body__tags {
    display: flex; flex-wrap: wrap; gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-hairline);
  }

  @media (max-width: 720px) {
    .post-head__title { font-size: var(--text-2xl); }
  }
</style>
