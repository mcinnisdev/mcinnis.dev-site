---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Kicker from '../../components/Kicker.astro';
import PostListItem from '../../components/PostListItem.astro';
import { formatDate } from '../../utils/format';
import { siteBase, breadcrumbSchema } from '../../utils/seo';

const baseUrl = siteBase(Astro.site);
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base
  title="Blog"
  description="Notes from the build — automation, agentic engineering, design tokens, and the occasional detour into IT operations."
  schema={[breadcrumbSchema(baseUrl, [{ name: 'Blog', path: '/blog' }])]}
>
  <section class="page-hero">
    <div class="hatch" aria-hidden="true"></div>
    <div class="page-hero__inner container">
      <Kicker tone="accent">Writing</Kicker>
      <h1 class="page-hero__title">Notes from the build</h1>
      <p class="page-hero__lede">
        Automation, agentic engineering, and the occasional detour into IT operations. Written
        while the thing is still fresh, which is the only time the details are still true.
      </p>
    </div>
  </section>

  <div class="posts container container--prose">
    <div>
      {posts.map((post) => (
        <PostListItem
          href={`/blog/${post.id}`}
          date={formatDate(post.data.date)}
          project={post.data.project}
          title={post.data.title}
          excerpt={post.data.excerpt}
        />
      ))}
    </div>
    <Kicker>Older posts land here as they're written</Kicker>
  </div>
</Base>

<style>
  .posts {
    padding-block: var(--space-7) var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
</style>
