---
/** Oversized mono stat strip — hero rail and About. */
interface Props { items: [string, string][] }
const { items } = Astro.props;
---
<div class="stat-row">
  {items.map(([value, label]) => (
    <div class="stat-row__item">
      <span class="stat-row__value">{value}</span>
      <span class="stat-row__label">{label}</span>
    </div>
  ))}
</div>

<style>
  .stat-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: var(--space-5);
    border-top: 1px solid var(--border-hairline);
    padding-top: var(--space-4);
  }
  .stat-row__item { display: flex; flex-direction: column; gap: 4px; }
  .stat-row__value {
    font-family: var(--font-display); font-size: var(--text-2xl);
    font-weight: var(--weight-bold); letter-spacing: var(--tracking-display);
    color: var(--text-display);
  }
  .stat-row__label {
    font-family: var(--font-mono); font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label); text-transform: uppercase;
    color: var(--text-meta);
  }
</style>
