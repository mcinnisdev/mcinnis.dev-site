---
import Icon from './Icon.astro';
/** Inline link. Keeps its colour on hover; the underline goes 35% → full. */
interface Props { href: string; external?: boolean }
const { href, external = false } = Astro.props;
const extra = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---
<a href={href} class="text-link" {...extra}>
  <slot />
  {external && <Icon name="arrow-up-right" size={13} class="text-link__ext" />}
</a>

<style>
  .text-link {
    color: var(--text-link);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--text-link) 35%, transparent);
    text-underline-offset: 3px;
    transition: var(--transition-control);
  }
  .text-link:hover { color: var(--text-link); text-decoration-color: currentColor; }
  .text-link__ext { vertical-align: -1px; margin-left: 2px; }
</style>
