---
import Icon from './Icon.astro';
import SlantRule from './SlantRule.astro';
import { site, socials } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <SlantRule height={10} density={7} />
  <div class="footer__inner container">
    <div class="footer__contact">
      <span class="footer__kicker">Get in touch</span>
      <a href={`mailto:${site.email}`} class="footer__email">{site.email}</a>
    </div>

    <div class="footer__side">
      <div class="footer__links">
        {socials.map((link) => (
          <a
            href={link.href}
            class="footer__link"
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            <Icon name={link.icon} size={14} />{link.label}
          </a>
        ))}
      </div>
      <span class="footer__note">© {year} {site.name} · {site.location}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface-inverse);
    color: var(--text-on-inverse);
    border-top: 1px solid var(--border-hairline);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: flex-end;
    justify-content: space-between;
    padding-block: var(--space-8) var(--space-7);
  }

  .footer__contact { display: flex; flex-direction: column; gap: var(--space-3); }
  .footer__kicker {
    font-family: var(--font-mono); font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label); text-transform: uppercase;
    color: var(--paper-300);
  }
  .footer__email {
    font-family: var(--font-display); font-size: var(--text-2xl);
    font-weight: var(--weight-medium); letter-spacing: var(--tracking-tight);
    color: var(--paper-50); text-decoration: none;
    transition: var(--transition-control);
  }
  .footer__email:hover { color: var(--terracotta-400); }

  .footer__side { display: flex; flex-direction: column; gap: var(--space-3); align-items: flex-end; }
  .footer__links { display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .footer__link {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: var(--text-xs);
    color: var(--paper-200); text-decoration: none;
    transition: var(--transition-control);
  }
  .footer__link:hover { color: var(--terracotta-400); }
  .footer__note { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--ink-300); }

  @media (max-width: 720px) {
    .footer__inner { flex-direction: column; align-items: flex-start; }
    .footer__side { align-items: flex-start; }
    .footer__email { font-size: var(--text-xl); }
  }
</style>
