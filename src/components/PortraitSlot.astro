---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Portrait frame — 4:5, 14px radius, hairline border, per the system's imagery rule.
 *
 * Pass an imported image and it renders optimised (Astro handles webp + sizing).
 * Pass nothing and it renders the labelled slot instead — never a stock photo.
 */
interface Props {
  image?: ImageMetadata;
  alt?: string;
  label?: string;
}
const { image, alt = '', label = 'headshot.jpg' } = Astro.props;
---

<div class="portrait">
  {image ? (
    <Image src={image} alt={alt} widths={[280, 560, 840]} sizes="(max-width: 860px) 240px, 280px" class="portrait__img" />
  ) : (
    <>
      <div class="portrait__hatch" aria-hidden="true"></div>
      <span class="portrait__label">{label}</span>
    </>
  )}
</div>

<style>
  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    display: grid;
    place-items: center;
    border-radius: var(--radius-card);
    border: 1px solid var(--border-subtle);
    background: var(--surface-sunken);
    box-shadow: var(--shadow-inset-hairline);
  }
  .portrait__img { width: 100%; height: 100%; object-fit: cover; }
  .portrait__hatch {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(108.4deg, rgba(250, 247, 244, .10) 0 1px, transparent 1px 9px);
  }
  .portrait__label {
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-meta);
  }
</style>
